# ---------------------------------------------------------------------------
# AnyHabit configuration
#
# Copy this file to `.env` and edit what you need:
#     cp .env.example .env
#     docker compose up -d --build
#
# Every core AnyHabit setting has a working default, so an empty .env still
# starts the normal app. MCP settings only matter when you run the MCP server.
# ---------------------------------------------------------------------------

# Port the app is served on. Use 8080 or similar if something already owns 80.
APP_PORT=80

# --- Security ---------------------------------------------------------------

# Signs your login sessions. CHANGE THIS before exposing AnyHabit beyond your
# own machine. Generate one with:  openssl rand -hex 32
# Changing it later is safe: it only signs everyone out, it never touches data.
ANYHABIT_SECRET_KEY=

# Whether the auth cookie is marked Secure (HTTPS-only).
#   auto  - decide per request; Secure over HTTPS, not over plain HTTP  (default)
#   true  - always Secure. Only use this if you always reach AnyHabit over HTTPS.
#   false - never Secure.
# Leave this on "auto": forcing "true" on a plain-HTTP LAN address makes the
# browser silently discard the cookie, which looks like login not working.
ANYHABIT_COOKIE_SECURE=auto

# SameSite policy for the auth cookie. "lax" suits a normal single-domain setup.
ANYHABIT_COOKIE_SAMESITE=lax

# Optional cookie domain, e.g. .example.com to share across subdomains.
ANYHABIT_COOKIE_DOMAIN=

# How long a session lasts, in seconds. Default is 7 days.
ANYHABIT_TOKEN_TTL_SECONDS=604800

# --- First-run account ------------------------------------------------------
# Created only when the database has no users at all. Existing accounts are
# never modified by these values.
ANYHABIT_BOOTSTRAP_USERNAME=owner
ANYHABIT_BOOTSTRAP_EMAIL=owner@anyhabit.local
ANYHABIT_BOOTSTRAP_PASSWORD=anyhabit

# --- Backups ----------------------------------------------------------------
# Before applying any schema change, AnyHabit copies the database to
# data/backups/ inside the db_data volume. Strongly recommended to leave on.
ANYHABIT_AUTO_BACKUP=true
ANYHABIT_BACKUP_RETENTION=10

# --- Advanced ---------------------------------------------------------------

# Extra browser origins allowed to call the API. Only needed when you run the
# frontend separately from the backend (for example `npm run dev`).
ANYHABIT_CORS_ORIGINS=

# DEBUG, INFO, WARNING or ERROR.
ANYHABIT_LOG_LEVEL=INFO

# Backend URL for running the frontend dev server against a remote backend.
# Leave empty when using `npm run dev`, which proxies to localhost:8000.
VITE_API_URL=

# --- MCP / AI integration ---------------------------------------------------
#
# These settings are only used by mcp/.
#
# URL the MCP server uses to reach AnyHabit.
#
# MCP running on the same host as the normal Docker Compose app:
#   http://127.0.0.1
#
# MCP running as a container on the same Compose network:
#   http://backend:8000
#
# Remote AnyHabit instance:
#   https://habits.example.com
#
# Leave empty when MCP is not used.
ANYHABIT_MCP_URL=

# Personal access token used by MCP.
# Create one in AnyHabit under Settings -> Developer.
# Use a dedicated token such as "MCP" and keep this file out of git.
ANYHABIT_MCP_TOKEN=

# HTTP timeout for MCP -> AnyHabit API requests, in seconds.
ANYHABIT_MCP_TIMEOUT_SECONDS=10

# Irreversible MCP actions (delete tracker/log/journal/group/member) are disabled
# unless this is explicitly true.
ANYHABIT_MCP_ALLOW_DESTRUCTIVE=false

# MCP transport when server.py is started directly.
#   stdio            - local AI clients launch the MCP process (default)
#   streamable-http  - serve MCP over HTTP for remote/deployed clients
ANYHABIT_MCP_TRANSPORT=stdio

# Streamable HTTP settings. Ignored for stdio.
ANYHABIT_MCP_HOST=127.0.0.1
ANYHABIT_MCP_PORT=8001
ANYHABIT_MCP_PATH=/mcp

# Stateless HTTP is useful behind some proxies/scaled deployments, but disables
# session state. Leave false unless you know you need it.
ANYHABIT_MCP_STATELESS_HTTP=false
